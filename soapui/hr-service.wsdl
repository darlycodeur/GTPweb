      <soap:operation soapAction=""/>
      <wsdl:input name="getAllDepartmentsRequest">
        <soap:body use="literal"/>
      </wsdl:input>
      <wsdl:output name="getAllDepartmentsResponse">
        <soap:body use="literal"/>
      </wsdl:output>
    </wsdl:operation>
  </wsdl:binding>
  <wsdl:service name="HrService">
