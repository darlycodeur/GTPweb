# ─── Serveur Node.js ───
PORT=5000

# ─── MongoDB ───
MONGO_URI=mongodb://127.0.0.1:27017/gestion_taches_projets

# ─── JWT ───
JWT_SECRET=change_this_secret_in_production
JWT_EXPIRES_IN=7d

# ─── SOAP : système legacy RH (Spring Boot) ───
# URL du contrat WSDL exposé par le micro-projet Spring Boot
SOAP_WSDL_URL=http://localhost:8080/ws/hr-service.wsdl
# Délai maximum d'attente d'une réponse SOAP (ms)
# Le nom DOIT être SOAP_TIMEOUT_MS : c'est la variable lue par src/config/soapConfig.js
SOAP_TIMEOUT_MS=15000
